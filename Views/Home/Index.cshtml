@{
    ViewData["Title"] = "Overview";
}

<section class="hero">
    <div>
       
        <h1>BITE Food Ordering and Delivery</h1>
        <p>
           A place to explore taste.
        </p>
        
    </div>
</section>

<section class="page-shell compact-shell">
    <div class="pattern-grid">
        <article>
            <h2>Restaurant Menus</h2>
            <p>Each restaurant has its own realistic menu instead of sharing the same meals.</p>
        </article>
        <article>
            <h2>Meal Customization</h2>
            <p>Add extras such as cheese, bacon, double patty, large portions, sauces, or gluten-free bases.</p>
        </article>
        <article>
            <h2>Flexible Checkout</h2>
            <p>Choose card, EFT, PayFast, promo discount, loyalty discount, or surge delivery pricing.</p>
        </article>
        <article>
            <h2>Live Updates</h2>
            <p>Customers, restaurant staff, kitchen staff, and drivers receive order status updates.</p>
        </article>
        <article>
            <h2>Delivery Ready</h2>
            <p>Orders include packaging, branding, preparation, and delivery status information.</p>
        </article>
        <article>
            <h2>Demo Records</h2>
            <p>The app keeps a short system log so the order flow can be reviewed after checkout.</p>
        </article>
    </div>
</section>
