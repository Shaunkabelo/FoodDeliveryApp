<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QuickBite</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="nav-shell">
            <a class="brand" asp-controller="Home" asp-action="Index">BITE</a>
            <div class="nav-actions">
                <a asp-controller="Home" asp-action="Index">Overview</a>
                <a class="nav-button" asp-controller="Order" asp-action="Create">New Order</a>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="app-footer">
        <span></span>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
